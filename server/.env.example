# PokeMatrix Server - Environment Variables

# Сервер
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://user:pass@host:5432/pokematrix
# TLS к PostgreSQL: require | disable | auto
# auto = TLS включён в production, выключен в разработке
DB_SSL=auto

# JWT
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=15m

# Telegram Bot Token — обязателен в production.
# Без него сервер не может проверить подпись initData и отказывает во входе.
BOT_TOKEN=

# Admin
# Значение НЕ должно храниться в репозитории: пароль из репозитория
# работал как Bearer-токен и давал полный доступ к save_data любого игрока.
ADMIN_PASS=change-this-to-a-random-secret
# Telegram ID администраторов через запятую
ADMIN_IDS=

# Вход без Telegram (initData="test"). Только для локальной разработки,
# в production сервер не запустится при ALLOW_DEV_LOGIN=true.
ALLOW_DEV_LOGIN=false

# CORS origins через запятую (в production задайте домен сайта)
CORS_ORIGINS=http://localhost:5173

# Логирование
LOG_LEVEL=debug
