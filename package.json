{
    "name": "leaguepm",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "render-build": "npm install --include=dev && npm --prefix server install --include=dev && npm --prefix server run build && npx vite build",
        "preview": "vite preview",
        "start": "node server/dist/index.js",
        "server:dev": "npm --prefix server run dev",
        "server:build": "npm --prefix server run build",
        "test:vitest": "vitest run",
        "test:e2e": "node e2e/smoke.mjs",
        "test:e2e:headed": "node e2e/smoke.mjs --headed",
        "test:watch": "vitest",
        "test": "vitest run",
        "verify": "node tools/verify/run.mjs",
        "verify:serve": "node tools/verify/run.mjs --serve"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.8",
        "@electric-sql/pglite-socket": "^0.2.11",
        "@types/node": "^25.9.1",
        "drizzle-kit": "^0.31.10",
        "playwright": "^1.60.0",
        "supertest": "^7.2.2",
        "typescript": "^6.0.3",
        "vite": "^8.0.12",
        "vitest": "^4.1.7"
    },
    "dependencies": {
        "@neon/config": "^1.8.3",
        "@neon/env": "^1.5.0",
        "socket.io-client": "^4.8.3"
    }
}
